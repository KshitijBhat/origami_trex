FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ARG EXECUTION_MODE=async

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/tmp/origami-home \
    USER=origami-policy \
    XDG_CACHE_HOME=/tmp/origami-cache \
    HF_HOME=/tmp/origami-cache/hf \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    TORCH_HOME=/tmp/origami-cache/torch \
    TORCHINDUCTOR_CACHE_DIR=/app/compile-cache/torchinductor \
    TRITON_CACHE_DIR=/app/compile-cache/triton \
    EXECUTION_MODE=${EXECUTION_MODE}

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-dev python3-pip ca-certificates \
    libgl1 libglib2.0-0 libgomp1 g++ gcc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# torch/torchvision from one index only (no --extra-index-url, or pip picks a
# higher cu13x wheel from PyPI and silently defeats the pin).  cu128 was the
# pin validated for this model code on the RTX 4090/5090 in the sept1 image;
# the training venv runs torch 2.6.0+cu124, which is the fallback if the
# compile path misbehaves under 2.11 (see the runbook, section 2).
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
ARG TORCH_SPEC="torch==2.11.0+cu128 torchvision==0.26.0+cu128"
RUN --mount=type=cache,target=/root/.cache/pip \
    python3 -m pip install --default-timeout=100 --retries=5 \
    --index-url "${TORCH_INDEX_URL}" ${TORCH_SPEC}

COPY requirements-inference.lock /tmp/requirements-inference.lock
RUN --mount=type=cache,target=/root/.cache/pip \
    python3 -m pip install -r /tmp/requirements-inference.lock \
    && rm /tmp/requirements-inference.lock

# --chown/--chmod on the COPY itself: a later `chmod -R` would copy the 8.5GB
# model.pt up into a fresh layer just to touch its metadata (seen as a real
# "No space left on device" on the sept1 build).
COPY --chown=65532:65532 --chmod=755 qwen_vla /app/qwen_vla
COPY --chown=65532:65532 --chmod=755 tactile_vqvae /app/tactile_vqvae
COPY --chown=65532:65532 --chmod=755 trex_origami /app/trex_origami
COPY --chown=65532:65532 --chmod=755 serve_origami_zenoh.py /app/serve_origami_zenoh.py
COPY --chown=65532:65532 --chmod=755 compile_warmup.py /app/compile_warmup.py
COPY --chown=65532:65532 --chmod=755 entrypoint.sh /app/entrypoint.sh

# Checkpoint: model.pt, config.json, training_args.json, stats_data.json,
# processor/.  NOT the training-resume `state/` directory (another ~13GB).
COPY --chown=65532:65532 --chmod=755 checkpoints/model /app/checkpoints/model

# Inference configuration -- read by trex_origami.policy.add_policy_arguments.
# These are the settings eval_deploy.py selected for checkpoint-2-7000; they
# are part of the compile-cache key (steps and K change the traced graphs), so
# changing any of them means regenerating compile-cache/ (runbook section 2).
ENV TREX_CKPT_PATH=/app/checkpoints/model \
    TREX_MODE=cascaded \
    TREX_TOTAL_STEPS=5 \
    TREX_SPLIT_STEP=3 \
    TREX_N_DRAWS=8 \
    TREX_ANCHOR_SOURCE=state_offset \
    TREX_SAFETY=tol \
    TREX_COMPILE=1 \
    ORIGAMI_ACTION_HORIZON=25 \
    PYTHONPATH=/app

# Pre-baked torch.compile cache: generated by running compile_warmup.py in a
# writable `--gpus all` container built from this same Dockerfile with an
# EMPTY compile-cache/, then `docker cp`'d out and rebuilt.  The runtime's
# read-only rootfs + noexec /tmp can only *load* kernels that already sit in
# this layer.  An empty directory builds fine (first call then compiles
# live, slowly, and crashes under --read-only -- so never ship it empty).
COPY --chown=65532:65532 --chmod=755 compile-cache /app/compile-cache

COPY --chown=65532:65532 --chmod=755 licenses/ /licenses/

USER 65532:65532

HEALTHCHECK NONE

ENTRYPOINT ["/app/entrypoint.sh"]
