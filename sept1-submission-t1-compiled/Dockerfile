FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ARG EXECUTION_MODE=async

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/tmp/origami-home \
    USER=origami-policy \
    XDG_CACHE_HOME=/tmp/origami-cache \
    HF_HOME=/tmp/origami-cache/hf \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    TORCH_HOME=/tmp/origami-cache/torch \
    TORCHINDUCTOR_CACHE_DIR=/app/compile-cache/torchinductor \
    TRITON_CACHE_DIR=/app/compile-cache/triton \
    EXECUTION_MODE=${EXECUTION_MODE}

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-dev python3-pip ca-certificates \
    libgl1 libglib2.0-0 libgomp1 g++ gcc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# torch/torchvision from the cu128 index first: no --extra-index-url, or pip
# would pick a higher cu13x wheel from PyPI and silently defeat the pin.
# cu128 (not cu124) is required for sm_120 (Blackwell/RTX 50-series) kernel
# support -- confirmed via a real forward pass on an RTX 5090; see
# origami_trex/blackwell_torch_versions.md for the isolated-venv verification.
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
RUN --mount=type=cache,target=/root/.cache/pip \
    python3 -m pip install --default-timeout=100 --retries=5 \
    --index-url "${TORCH_INDEX_URL}" torch==2.11.0+cu128 torchvision==0.26.0+cu128

COPY requirements-inference.lock /tmp/requirements-inference.lock
RUN --mount=type=cache,target=/root/.cache/pip \
    python3 -m pip install -r /tmp/requirements-inference.lock \
    && rm /tmp/requirements-inference.lock

# --chown/--chmod set ownership/permissions as part of the same write these
# COPY instructions already do -- unlike a separate `RUN chown -R`/`chmod -R`
# pass, this never needs to "copy up" an already-written file from a lower
# layer just to touch its metadata. That copy-up is not free: on the 8.5GB
# model.pt, a later `chmod -R a+rX /app` silently duplicated the entire file
# into a new layer (confirmed via a real build failure: "No space left on
# device" while chmod-ing model.pt, despite tens of GB nominally free) --
# doing it here instead avoids that duplication entirely.
COPY --chown=65532:65532 --chmod=755 qwen_vla /app/qwen_vla
COPY --chown=65532:65532 --chmod=755 tactile_vqvae /app/tactile_vqvae
COPY --chown=65532:65532 --chmod=755 trex_policy_server.py /app/trex_policy_server.py
COPY --chown=65532:65532 --chmod=755 entrypoint.sh /app/entrypoint.sh
COPY --chown=65532:65532 --chmod=755 compile_warmup.py /app/compile_warmup.py

# Checkpoint set: a training run's self-contained output dir (model.pt,
# config.json, training_args.json, stats_data.json, processor/). Swap this
# COPY to point at the final chosen checkpoint before building.
COPY --chown=65532:65532 --chmod=755 checkpoints/model /app/checkpoints/model

ENV TREX_CKPT_PATH=/app/checkpoints/model \
    ORIGAMI_ACTION_HORIZON=25 \
    PYTHONPATH=/app

# Pre-baked torch.compile cache (see compile_warmup.py + docs/note below):
# generated by running compile_warmup.py in a --gpus all container from this
# same image *before* this COPY existed, then `docker cp`'d out into the build
# context. Baking it in here means the read-only + noexec /tmp runtime never
# needs to write or execute a freshly-compiled kernel -- Triton only loads
# what's already sitting in this layer. Empty dir is fine on a build that
# hasn't generated it yet; torch.compile then falls back to compiling fresh
# (slow first call) instead of failing.
COPY --chown=65532:65532 --chmod=755 compile-cache /app/compile-cache

COPY --chown=65532:65532 --chmod=755 licenses/ /licenses/

USER 65532:65532

HEALTHCHECK NONE

ENTRYPOINT ["/app/entrypoint.sh"]
