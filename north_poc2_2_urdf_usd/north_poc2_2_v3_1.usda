    }

    # ========================================
    # Collision Filtering: Left Arm link_5 and link_7
    # ========================================
    over "left_arm_link_5" (
        prepend apiSchemas = ["PhysicsFilteredPairsAPI"]
    )
    {
        rel physics:filteredPairs = </North_Poc2_2_V3_1/left_arm_link_7>
        rel physics:simulationOwner
    }

    over "left_arm_link_7" (
